  "values": {
    "about": [
      "A sample of a column's values is checked rule by rule, in this order; the first rule that fits names it.",
      "share: the rule fits when at least this share of the non-empty values matches one of its patterns.",
      "normalise: what is done to a value before matching (see 'normalisers').",
      "not_for_families / not_for_name_endings: column types and names the rule is never applied to.",
      "Patterns are Python regular expressions and must match the whole normalised value."
    ],
    "min_values": 3,
    "normalisers": {
      "trim": {"remove": "", "replace": []},
      "compact": {"remove": "[\\s\\-]", "replace": []},
      "phone": {"remove": "[\\s\\-.()\\[\\]/]", "replace": [["^00966", "+966"], ["^\\+9660", "+966"]]}
    },
    "rules": [
      {"category": "email", "share": 0.8, "normalise": "trim",
       "patterns": {"e-mail address": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$"}},
      {"category": "iban", "share": 0.8, "normalise": "compact",
       "patterns": {"Saudi IBAN": "(?i)^SA\\d{22}$"}},
      {"category": "phone", "share": 0.5, "normalise": "phone",
       "patterns": {
         "Saudi mobile": "^(?:\\+?966|0)?5\\d{8}$",
         "Saudi landline": "^(?:\\+?966|0)[1-7]\\d{8}$",
         "international number": "^(?:\\+|00)[1-9]\\d{7,14}$"}},
      {"category": "national_id", "share": 0.8, "normalise": "compact",
       "patterns": {"Saudi national ID / Iqama": "^[12]\\d{9}$"},
       "not_for_families": ["date"],
       "not_for_name_endings": ["_ts", "_time", "epoch"]}
    ]
  },

  "masking": {
    "about": [
      "A masked value keeps its first and last characters: 05******67, a***@d***.com.",
      "Values of fully_masked_up_to characters or fewer, birth dates and text that looks like a date keep nothing.",
      "fully_masked_categories: every letter and digit of a value is hidden; its length and punctuation stay.",
      "length_hidden_categories: nothing of a value stays, not even its length: every value is *****. The",
      "  column's statistics keep no top values and no text lengths either, only counts and null %.",
      "date_like: Python regular expressions; text that matches one of them whole is masked completely."
    ],
    "fully_masked_up_to": 4,
    "fully_masked_categories": ["birth_date", "salary"],
    "length_hidden_categories": ["salary"],
    "date_like": [
      "\\d{4}[-/.]\\d{1,2}[-/.]\\d{1,2}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2}(?:[.,]\\d+)?)?\\s*(?:[AaPp][Mm])?\\s*(?:Z|[+-]\\d{2}:?\\d{2})?)?",
      "\\d{1,2}[-/.]\\d{1,2}[-/.]\\d{2,4}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2}(?:[.,]\\d+)?)?\\s*(?:[AaPp][Mm])?)?",
      "\\d{1,2}[-/. ]?[A-Za-z]{3,9}[-/., ]{0,2}\\d{2,4}(?:[ T]\\d{1,2}[:.]\\d{2}(?:[:.]\\d{2}(?:[.,]\\d+)?)?\\s*(?:[AaPp][Mm])?)?",
      "[A-Za-z]{3,9}[-/. ]\\d{1,2}(?:st|nd|rd|th)?,?[-/ ]\\d{2,4}",
      "(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])(?:[ T]?\\d{4}(?:\\d{2})?)?"
    ]
  }
}
